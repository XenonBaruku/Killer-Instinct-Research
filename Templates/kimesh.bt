typedef struct
{
    float X; float Y; float Z;
}
vec3 <read=Str("[%f, %f, %f]", X, Y, Z), write=Vec3FWrite>;

void Vec3FWrite( vec3 &v, string s )
{
    SScanf( s, "[%f, %f, %f]", v.X, v.Y, v.Z );
}

typedef struct
{
    float X; float Y; float Z; float W;
}
vec4 <read=Str("[%f, %f, %f, %f]", X, Y, Z, W), write=Vec4FWrite>;

void Vec4FWrite( vec4 &v, string s )
{
    SScanf( s, "[%f, %f, %f, %f]", v.X, v.Y, v.Z, v.W );
}

typedef struct
{
    uint8 X; uint8 Y; uint8 Z; uint8 W;
